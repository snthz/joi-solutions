---
const valueCards = [
  {
    title: "Seguridad Financiera",
    description:
      "Protegemos las transacciones con tecnología segura y transparente para usuarios y comercios.",
    icon: "fas fa-shield-alt",
  },
  {
    title: "Cashless",
    description:
      "Reducimos la fricción operativa y facilitamos experiencias digitales más ordenadas y seguras.",
    icon: "fas fa-money-bill-wave",
  },
  {
    title: "Visibilidad total",
    description:
      "Accede a información clara y en tiempo real para tomar mejores decisiones.",
    icon: "fas fa-chart-line",
  },
];
---

<section class="av-section relative w-full py-20 md:py-28 px-6 md:px-10 overflow-hidden bg-gradient-to-b from-[#f7f8fb] via-[#eef0f6] to-[#f7f8fb]">
  <!-- Background pattern + ambient layers -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
    <!-- Dot grid pattern -->
    <div
      class="absolute inset-0 opacity-[0.5]"
      style="background-image: radial-gradient(rgba(32,57,111,0.12) 1px, transparent 1px); background-size: 22px 22px;"
    ></div>
    <!-- Soft glow orbs -->
    <div class="absolute -top-32 -left-24 w-[480px] h-[480px] rounded-full opacity-70" style="background: radial-gradient(circle, rgba(253,198,50,0.14) 0%, transparent 70%);"></div>
    <div class="absolute -bottom-32 -right-24 w-[520px] h-[520px] rounded-full opacity-70" style="background: radial-gradient(circle, rgba(32,57,111,0.10) 0%, transparent 70%);"></div>
    <!-- Top + bottom fade for soft transition into adjacent sections -->
    <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
  </div>

  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <!-- Left column: heading -->
    <div class="av-left text-center lg:text-left">
      <span class="av-label inline-block text-xs font-semibold tracking-[0.2em] uppercase text-tertiary mb-5">
        Valor agregado
      </span>
      <h2 class="av-heading text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-neutral-900 leading-[1.1] tracking-tight">
        ¿Por qué elegir <span class="text-tertiary">JoiSolutions</span>?
      </h2>
      <p class="av-subheading mt-6 text-base md:text-lg text-neutral-600 leading-relaxed max-w-md mx-auto lg:mx-0">
        Tecnología que simplifica y potencia tu crecimiento.
      </p>
    </div>

    <!-- Right column: stacked cards -->
    <div class="av-right flex flex-col gap-5">
      {valueCards.map((card, index) => (
        <article class="av-card group relative bg-white/90 backdrop-blur-sm border border-neutral-200/70 rounded-2xl p-6 md:p-7 shadow-[0_2px_6px_rgba(32,57,111,0.04)] transition-all duration-300 hover:border-tertiary/40 hover:shadow-[0_10px_28px_rgba(32,57,111,0.08)] hover:-translate-y-0.5" data-index={index}>
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-tertiary/10 flex items-center justify-center text-tertiary group-hover:bg-tertiary group-hover:text-white transition-colors duration-300">
              <i class={`${card.icon} text-base`}></i>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-lg md:text-xl font-bold text-neutral-900 mb-1.5 tracking-tight">
                {card.title}
              </h3>
              <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
                {card.description}
              </p>
            </div>
          </div>
          <!-- Accent corner -->
          <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-tertiary/0 rounded-tl-2xl group-hover:border-tertiary/60 transition-all duration-300"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .av-label, .av-heading, .av-subheading { opacity: 0; }
  .av-card { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .av-label, .av-heading, .av-subheading, .av-card {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const avLabel = document.querySelector('.av-label') as HTMLElement;
  const avHeading = document.querySelector('.av-heading') as HTMLElement;
  const avSubheading = document.querySelector('.av-subheading') as HTMLElement;
  const avCards = document.querySelectorAll('.av-card') as NodeListOf<HTMLElement>;

  if (!prefersReduced && avHeading) {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: '.av-section', start: 'top 80%', toggleActions: 'play none none none' }
    });

    tl.fromTo(avLabel,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
      .fromTo(avHeading,
        { opacity: 0, y: 24, filter: 'blur(4px)' },
        { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.7, ease: 'power3.out' }, '-=0.25')
      .fromTo(avSubheading,
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' }, '-=0.4')
      .fromTo(avCards,
        { opacity: 0, x: 40, filter: 'blur(4px)' },
        { opacity: 1, x: 0, filter: 'blur(0px)', duration: 0.6, ease: 'power3.out', stagger: 0.12 }, '-=0.35');
  } else {
    gsap.set([avLabel, avHeading, avSubheading, ...avCards], { opacity: 1, y: 0, x: 0, filter: 'blur(0px)' });
  }
</script>
